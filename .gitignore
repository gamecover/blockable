# Ignore every root-level item unless explicitly required below.
/*

# Repository metadata and project documentation
!/.gitignore
!/AGENTS.md
!/LICENSE
!/README.md
!/update.txt

# Package and build configuration
!/package.json
!/package-lock.json
!/eslint.config.js
!/vite.config.js
!/index.html
!/.env.example

# Game design documents and source code, including runtime assets
!/docs/
!/docs/**
!/src/
!/src/**
